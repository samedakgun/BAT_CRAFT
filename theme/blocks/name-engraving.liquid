{% comment %}
  İsim Gravürü — canlı önizlemeli kişiselleştirme bloğu.

  Müşteri ismini yazdıkça sopa görselinin üzerinde gravür fontuyla belirir.
  Girilen değer line item property olarak siparişe, sipariş e-postasına ve
  kargo fişine düşer. Ek uygulama gerekmez.

  Kurulum notları:
  - "Gravür görseli" olarak sopanın düz (isimsiz) fotoğrafını seç.
  - Yazı konumunu (X/Y), açıyı ve boyutu tema editöründen ayarla.
  - Fontu ATÖLYENİN KULLANDIĞI FONTLA AYNI seç. Farklıysa müşteri
    "beklediğim gibi gelmedi" der. Bkz. GELISTIRME-PLANI.md 3.1.5
{% endcomment %}

{%- liquid
  assign block_settings = block.settings
  assign property_key = block_settings.property_key | default: 'İsim'
  assign property_name = 'properties[KEY]' | replace: 'KEY', property_key

  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign input_id = 'NameEngraving-' | append: block.id
  assign skip_id = 'NameEngravingSkip-' | append: block.id

  assign preview_image = block_settings.preview_image | default: closest.product.featured_media.preview_image

  assign sample = block_settings.sample_text | default: 'Haydar'
  if block_settings.text_case == 'upper'
    assign sample = sample | upcase
  elsif block_settings.text_case == 'title'
    assign sample = sample | capitalize
  endif

  assign skip_key = property_key | append: ' tercihi'
  assign skip_property_name = 'properties[KEY]' | replace: 'KEY', skip_key

  # Gravür yazı tipi. "script" temaya gömülü el yazısı fontudur (Dancing Script),
  # atölyedeki kazıma fontuyla eşleşsin diye seçilebilir yapıldı.
  case block_settings.font_style
    when 'heading'
      assign engraving_font_stack = 'var(--font-heading--family)'
      assign engraving_font_weight = '700'
    when 'body'
      assign engraving_font_stack = 'var(--font-body--family)'
      assign engraving_font_weight = '400'
    else
      assign engraving_font_stack = '"BatCraft Gravur", "Segoe Script", cursive'
      assign engraving_font_weight = '700'
  endcase
-%}

{%- comment -%}
  El yazısı gravür fontu temaya gömülü (harici istek yok).
  Türkçe karakterler latin + latin-ext alt kümelerine dağılmış durumda,
  bu yüzden iki @font-face gerekiyor: ı U+0131 latin'de, ğ/ş/İ latin-ext'te.
{%- endcomment -%}
{% style %}
  @font-face {
    font-family: 'BatCraft Gravur';
    src: url({{ 'gravur-latin.woff2' | asset_url }}) format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
      U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'BatCraft Gravur';
    src: url({{ 'gravur-latin-ext.woff2' | asset_url }}) format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
      U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020,
      U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
{% endstyle %}

<div
  class="name-engraving spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {%- if preview_image != blank -%}
    <div
      class="name-engraving__stage"
      ref="stage"
      style="
        --engrave-x: {{ block_settings.text_x }}%;
        --engrave-y: {{ block_settings.text_y }}%;
        --engrave-rotate: {{ block_settings.text_rotation }}deg;
        --engrave-size: {{ block_settings.text_size }}cqw;
        --engrave-tracking: {{ block_settings.letter_spacing }}em;
        --engrave-max-width: {{ block_settings.text_max_width }}%;
        --engrave-color: {{ block_settings.text_color }};
        --engrave-shadow-opacity: {{ block_settings.text_emboss | divided_by: 100.0 }};
        --engrave-font: {{ engraving_font_stack }};
        --engrave-font-weight: {{ engraving_font_weight }};
      "
    >
      {{
        preview_image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 750px) 50vw, 100vw',
          widths: '400, 600, 800, 1000, 1200, 1400',
          class: 'name-engraving__image',
          alt: preview_image.alt
      }}

      <div class="name-engraving__layer" aria-hidden="true">
        <span
          class="name-engraving__text"
          ref="preview"
          data-sample="{{ sample | escape }}"
        >{{ sample }}</span>
      </div>
    </div>
  {%- endif -%}

  <div class="name-engraving__field">
    {%- if block_settings.heading != blank -%}
      <p class="name-engraving__heading">{{ block_settings.heading | escape }}</p>
    {%- endif -%}

    {%- if block_settings.description != blank -%}
      <p class="name-engraving__description">{{ block_settings.description | escape }}</p>
    {%- endif -%}

    <div class="name-engraving__input-wrapper">
      <input
        ref="textInput"
        on:input="/handleInput"
        type="text"
        id="{{ input_id }}"
        name="{{ property_name }}"
        class="field__input name-engraving__input"
        form="{{ product_form_id }}"
        placeholder="{{ block_settings.placeholder | escape }}"
        maxlength="{{ block_settings.max_length }}"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        data-case="{{ block_settings.text_case }}"
        aria-describedby="{{ input_id }}-count"
        {% if block_settings.required %}
          required
          aria-required="true"
        {% endif %}
      >
      <span
        class="name-engraving__count"
        id="{{ input_id }}-count"
        ref="characterCount"
        data-template="{{ block_settings.counter_label | default: '[current]/[max]' | escape }}"
      >0/{{ block_settings.max_length }}</span>
    </div>

    <p class="name-engraving__error" ref="error" role="status" hidden></p>

    {%- if block_settings.allow_skip -%}
      <label class="name-engraving__skip" for="{{ skip_id }}">
        <input
          ref="skipInput"
          on:change="/handleSkipToggle"
          type="checkbox"
          id="{{ skip_id }}"
          name="{{ skip_property_name }}"
          value="{{ block_settings.skip_label | escape }}"
          form="{{ product_form_id }}"
        >
        <span>{{ block_settings.skip_label | escape }}</span>
      </label>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  name-engraving-component {
    display: block;
    width: 100%;
  }

  name-engraving-component .name-engraving__stage {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    border-radius: var(--style-border-radius-inputs, 0);
    margin-block-end: var(--padding-md);
  }

  name-engraving-component .name-engraving__image {
    display: block;
    width: 100%;
    height: auto;
  }

  name-engraving-component .name-engraving__layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  name-engraving-component .name-engraving__text {
    position: absolute;
    left: var(--engrave-x);
    top: var(--engrave-y);
    transform: translate(-50%, -50%) rotate(var(--engrave-rotate)) scale(var(--engrave-scale, 1));
    transform-origin: center;
    white-space: nowrap;
    font-family: var(--engrave-font);
    font-weight: var(--engrave-font-weight);
    font-size: var(--engrave-size);
    letter-spacing: var(--engrave-tracking);
    line-height: 1;
    color: var(--engrave-color);
    /* Oyma hissi: üstte koyu, altta açık ince gölge */
    text-shadow:
      0 1px 0 rgb(255 255 255 / var(--engrave-shadow-opacity)),
      0 -1px 1px rgb(0 0 0 / var(--engrave-shadow-opacity));
    transition: opacity 0.15s ease;
  }

  /* Müşteri henüz yazmadıysa örnek isim soluk gösterilir */
  name-engraving-component .name-engraving__text[data-state='sample'] {
    opacity: 0.45;
  }

  name-engraving-component .name-engraving__text[data-state='empty'] {
    opacity: 0;
  }

  name-engraving-component .name-engraving__heading {
    margin: 0 0 var(--padding-2xs);
  }

  name-engraving-component .name-engraving__description {
    font-size: min(0.85em, var(--font-paragraph--size));
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
    margin: 0 0 var(--padding-sm);
  }

  name-engraving-component .name-engraving__input-wrapper {
    position: relative;
  }

  name-engraving-component .name-engraving__input {
    width: 100%;
    padding-inline-end: 4.5rem;
    /* stylelint-disable-next-line declaration-no-important */
    color: var(--color-input-text) !important;
  }

  name-engraving-component .name-engraving__input[data-case='upper'] {
    text-transform: uppercase;
  }

  name-engraving-component .name-engraving__input[data-case='title'] {
    text-transform: capitalize;
  }

  name-engraving-component .name-engraving__count {
    position: absolute;
    inset-inline-end: var(--input-padding-x, 1rem);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    font-size: 0.8em;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  name-engraving-component .name-engraving__error {
    margin: var(--padding-2xs) 0 0;
    font-size: 0.85em;
    color: var(--color-error, #b3261e);
  }

  name-engraving-component .name-engraving__error[hidden] {
    display: none;
  }

  name-engraving-component .name-engraving__skip {
    display: flex;
    align-items: center;
    gap: var(--padding-2xs);
    margin-block-start: var(--padding-sm);
    font-size: 0.9em;
    cursor: pointer;
  }

  name-engraving-component .name-engraving__field:has(.name-engraving__input:disabled) .name-engraving__input {
    opacity: 0.5;
  }
{% endstylesheet %}

<script
  src="{{ 'name-engraving.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

